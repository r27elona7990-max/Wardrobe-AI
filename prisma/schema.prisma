// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  password      String
  name          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  clothingItems ClothingItem[]
  outfits       Outfit[]
  resetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ClothingItem {
  id          String       @id @default(cuid())
  name        String
  imagePath   String
  category    String
  tags        String?
  colors      String[]     @default([])
  styles      String[]     @default([])
  fits        String[]     @default([])
  aesthetics  String[]     @default([])
  seasons     String[]     @default([])
  materials   String[]     @default([])
  aiMetadata  Json?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
}

model Outfit {
  id        String       @id @default(cuid())
  name      String
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OutfitItem[]
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

model OutfitItem {
  outfitId       String
  clothingItemId String
  position       Int
  outfit         Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  clothingItem   ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@id([outfitId, clothingItemId])
  @@unique([outfitId, position])
  @@index([clothingItemId])
}
